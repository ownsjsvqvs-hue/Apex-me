-- APEX SUPREME • INSTANT HARD-LOCK AIMBOT ENGINE
local activeTarget = nil

local function IsLethalThreat(targetPlayer)
    if not targetPlayer.Character then return false end
    local equippedTool = targetPlayer.Character:FindFirstChildOfClass("Tool")
    
    if equippedTool then
        local safeItems = {["Keycard"] = true, ["Crude Knife"] = true, ["Donut"] = true}
        if not safeItems[equippedTool.Name] then
            return true
        end
    end
    return false
end

local function FindValidApexTarget()
    local closestPlayer = nil
    local shortestDistance = _G.TrackingRadius
    local localTeam = Player.Team and Player.Team.Name or ""

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                local enemyTeam = p.Team and p.Team.Name or ""
                
                if localTeam ~= enemyTeam then
                    local isValidTarget = false
                    
                    if localTeam == "Guards" then
                        if _G.TargetCriminals and enemyTeam == "Criminals" then
                            isValidTarget = true
                        elseif _G.TargetInmates and enemyTeam == "Inmates" then
                            if IsLethalThreat(p) then isValidTarget = true end
                        end
                        
                    elseif localTeam == "Criminals" or localTeam == "Inmates" then
                        if _G.TargetGuards and enemyTeam == "Guards" then
                            isValidTarget = true
                        elseif _G.TargetCriminals and enemyTeam == "Criminals" then
                            isValidTarget = true
                        elseif _G.TargetInmates and enemyTeam == "Inmates" then
                            isValidTarget = true
                        end
                    end
                    
                    if isValidTarget then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                        if onScreen then
                            local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                            if mouseDist < shortestDistance then
                                local raycastParams = RaycastParams.new()
                                raycastParams.FilterDescendantsInstances = {Player.Character, p.Character}
                                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                                
                                local rayResult = Workspace:Raycast(Camera.CFrame.Position, p.Character.Head.Position - Camera.CFrame.Position, raycastParams)
                                
                                if not rayResult then
                                    shortestDistance = mouseDist
                                    closestPlayer = p
                                end
                            end
                        end
                    end
                    
                end
            end
        end
    end
    return closestPlayer
end

RunService.Heartbeat:Connect(function()
    if _G.ApexTrackingEnabled and Player.Character and Player.Character:FindFirstChildOfClass("Tool") then
        local isClicking = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        
        if isClicking then
            if not activeTarget or not activeTarget.Character or not activeTarget.Character:FindFirstChild("Head") or activeTarget.Character.Humanoid.Health <= 0 then
                activeTarget = FindValidApexTarget()
            end
            
            if activeTarget and activeTarget.Character and activeTarget.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, activeTarget.Character.Head.Position)
            end
        else
            activeTarget = nil
        end
    else
        activeTarget = nil
    end
end)

