local function RegisterStroke(stroke)
	table.insert(ActiveStrokes, stroke)
	stroke.Color = PrimaryThemeColor
end

local function RegisterThemedBackground(btn)
	table.insert(ThemedBackgrounds, btn)
	btn.BackgroundColor3 = PrimaryThemeColor
end

local function RegisterThemedButton(btn)
	table.insert(ThemedButtons, btn)
	btn.BackgroundColor3 = PrimaryThemeColor
end

local function UpdateThemeColors(newColor)
	PrimaryThemeColor = newColor
	for _, stroke in ipairs(ActiveStrokes) do
		if stroke and stroke.Parent then
			stroke.Color = PrimaryThemeColor
		end
	end
	for _, btn in ipairs(ThemedBackgrounds) do
		if btn and btn.Parent then
			btn.BackgroundColor3 = PrimaryThemeColor
		end
	end
	for _, btn in ipairs(ThemedButtons) do
		if btn and btn.Parent then
			btn.BackgroundColor3 = PrimaryThemeColor
		end
	end
	if ReopenBtn then
		ReopenBtn.BackgroundColor3 = PrimaryThemeColor
		if ReopenStroke then
			ReopenStroke.Color = PrimaryThemeColor
		end
	end
end

