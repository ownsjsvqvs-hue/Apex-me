--============================================================
-- RUNTIME ENGINE LOOP (HEARTBEAT) & PROXIMITY BOMB TRANSFER
--============================================================

local lastBombTransferTick = 0

RunService.RenderStepped:Connect(function(dt)
	if State.Destroyed or not State.Authenticated then
		return
	end

	local Character = Player.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")

	if not Character or not Humanoid or not RootPart then
		return
	end

	if Humanoid.Health <= 0 then return end

	Humanoid.UseJumpPower = true
	if State.JumpEnabled then
		if Humanoid.JumpPower ~= State.JumpPower then
			Humanoid.JumpPower = State.JumpPower
		end
	else
		if Humanoid.JumpPower ~= NORMAL_GAME_JUMP then
			Humanoid.JumpPower = NORMAL_GAME_JUMP
		end
	end

	if State.SpeedEnabled and Humanoid.MoveDirection.Magnitude > 0 then
		local moveDir = Humanoid.MoveDirection
		local delta = moveDir * (State.Speed * dt)
		RootPart.CFrame = RootPart.CFrame + Vector3.new(delta.X, 0, delta.Z)
	end

	-- Hitbox & Match Filtering Engine
	local inMatch = IsInActiveMatch()
	if (State.HitboxEnabled or State.BombTransferEnabled) and inMatch then
		local activeEnemies = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if IsValidEnemy(p) then
				local enemyRoot = p.Character:FindFirstChild("HumanoidRootPart")
				if enemyRoot then
					activeEnemies[p] = enemyRoot
				end
			end
		end

		for p, enemyRoot in pairs(activeEnemies) do
			local box = enemyHitboxes[p]
			if not box or not box.Parent then
				box = Instance.new("Part")
				box.Name = "ApexHitboxDebug"
				box.Size = Vector3.new(4, 5, 4)
				box.Anchored = true
				box.CanCollide = false
				box.Transparency = State.HitboxEnabled and 0.75 or 1
				box.Color = Theme.Accent
				box.Material = Enum.Material.Neon
				box.Parent = Workspace
				enemyHitboxes[p] = box
			else
				box.Transparency = State.HitboxEnabled and 0.75 or 1
			end
			box.CFrame = enemyRoot.CFrame

			-- Proximity Bomb Transfer Logic (Triggered when hitboxes touch/are within close range)
			if State.BombTransferEnabled and (tick() - lastBombTransferTick > 0.5) then
				local distance = (RootPart.Position - enemyRoot.Position).Magnitude
				if distance <= 4.5 then
					pcall(function()
						for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
							if child:IsA("RemoteEvent") and (string.find(string.lower(child.Name), "bomb") or string.find(string.lower(child.Name), "pass") or string.find(string.lower(child.Name), "transfer") or string.find(string.lower(child.Name), "touch")) then
								child:FireServer(p)
							end
						end
					end)
					lastBombTransferTick = tick()
				end
			end
		end

		for p, box in pairs(enemyHitboxes) do
			if not activeEnemies[p] then
				if box then box:Destroy() end
				enemyHitboxes[p] = nil
			end
		end
	else
		ClearEnemyHitboxes()
	end
end)

