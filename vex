local function MakeStepper(parent, title, minValue, maxValue, initialValue, stepSize, callback)
	local card = MakeCard(parent, 76)

	local titleLabel = MakeText(card, title, 13, Theme.Text)
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Position = UDim2.fromScale(0.05, 0.12)
	titleLabel.Size = UDim2.fromScale(0.50, 0.35)

	local valueLabel = MakeText(card, tostring(initialValue), 13, Theme.Accent)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.Position = UDim2.fromScale(0.05, 0.52)
	valueLabel.Size = UDim2.fromScale(0.50, 0.35)

	local minusBtn = MakeButton(card, "-")
	minusBtn.TextSize = 16
	minusBtn.Font = Enum.Font.GothamBold
	minusBtn.Position = UDim2.fromScale(0.60, 0.20)
	minusBtn.Size = UDim2.fromOffset(34, 34)

	local plusBtn = MakeButton(card, "+")
	plusBtn.TextSize = 16
	plusBtn.Font = Enum.Font.GothamBold
	plusBtn.Position = UDim2.fromScale(0.80, 0.20)
	plusBtn.Size = UDim2.fromOffset(34, 34)

	local currentValue = initialValue

	local function UpdateVal(newVal)
		currentValue = math.clamp(newVal, minValue, maxValue)
		valueLabel.Text = tostring(currentValue)
		callback(currentValue)
	end

	minusBtn.Activated:Connect(function()
		UpdateVal(currentValue - stepSize)
	end)

	plusBtn.Activated:Connect(function()
		UpdateVal(currentValue + stepSize)
	end)

	return card
end

