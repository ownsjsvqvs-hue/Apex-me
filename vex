--============================================================
-- CHARACTER & WALL HOP V10 ENGINE (INSTANT VELOCITY)
--============================================================

local enemyHitboxes = {}

local function ClearEnemyHitboxes()
	for _, box in pairs(enemyHitboxes) do
		if box and box.Parent then box:Destroy() end
	end
	enemyHitboxes = {}
end

-- Fine-tuned configurations for smooth execution
local DETECTION_DISTANCE = 3.5  -- Scanning range for obstacles
local WALL_UP_FORCE = 44        -- Smooth vertical launch velocity
local BOUNCE_OUT_FORCE = 3      -- Clean repulsion to break friction stickiness
local COOLDOWN_TIME = 0.18      -- Critical anti-lag timer (prevents spam stuttering)

local IsOnCooldown = false

UIS.JumpRequest:Connect(function()
	if State.Destroyed or not State.WallHopEnabled then return end
	if IsOnCooldown then return end
	
	local Character = Player.Character
	local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	
	if not RootPart or not Humanoid then return end
	if Humanoid.Health <= 0 then return end
	
	-- Multi-ray parameter configuration
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {Character}
	raycastParams.IgnoreWater = true
	
	-- 1. Scan direct forward (For vertical walls and pillars)
	local frontOrigin = RootPart.Position
	local frontDirection = RootPart.CFrame.LookVector * DETECTION_DISTANCE
	local frontResult = Workspace:Raycast(frontOrigin, frontDirection, raycastParams)
	
	-- 2. Scan downward-forward (Specifically engineered to detect sloped stairs)
	local stairOrigin = RootPart.Position - Vector3.new(0, 1.5, 0)
	local stairDirection = (RootPart.CFrame.LookVector + Vector3.new(0, -0.5, 0)).Unit * DETECTION_DISTANCE
	local stairResult = Workspace:Raycast(stairOrigin, stairDirection, raycastParams)
	
	-- Choose whichever obstacle surface is actively hit
	local activeHit = frontResult or stairResult
	
	if activeHit and activeHit.Instance and activeHit.Instance.CanCollide then
		-- Engage Cooldown Lockout immediately to protect framerate
		IsOnCooldown = true
		
		local surfaceNormal = activeHit.Normal
		
		-- Interrupt native state calculations to force physics injection
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		
		-- Calculate sleek trajectory: Upwards boost mixed with a subtle outward push
		local cleanPush = (surfaceNormal * BOUNCE_OUT_FORCE) + Vector3.new(0, WALL_UP_FORCE, 0)
		
		-- Direct velocity assignment
		RootPart.AssemblyLinearVelocity = Vector3.new(
			RootPart.AssemblyLinearVelocity.X + cleanPush.X,
			cleanPush.Y,
			RootPart.AssemblyLinearVelocity.Z + cleanPush.Z
		)

		if WallStateLabel then
			WallStateLabel.Text = "STATUS: HOPPED!"
			WallStateLabel.TextColor3 = Theme.Success
			task.delay(0.2, function()
				if State and State.WallHopEnabled and WallStateLabel then
					WallStateLabel.Text = "STATUS: READY"
					WallStateLabel.TextColor3 = Theme.Success
				end
			end)
		end
		
		-- Let physics settle smoothly before releasing the lockout loop
		task.wait(COOLDOWN_TIME)
		IsOnCooldown = false
	end
end)

