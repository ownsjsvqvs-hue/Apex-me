--============================================================

local function IsValidEnemy(otherPlayer)
	if otherPlayer == Player then return false end
	if not otherPlayer.Character then return false end
	
	local enemyHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not enemyHum or enemyHum.Health <= 0 then return false end

	-- Check if teams are active and configured
	if Player.Team and otherPlayer.Team then
		if Player.Team == otherPlayer.Team then
			return false
		end
	end

	return true
end

local function IsInActiveMatch()
	for _, p in ipairs(Players:GetPlayers()) do
		if IsValidEnemy(p) then
			return true
		end
	end
	return false
end

