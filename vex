-- LOADING SYSTEM
--============================================================

local function RunLoading()
	if State.Loading then return end
	State.Loading = true
	KeyWindow.Visible = false
	Main.Visible = false
	Reopen.Visible = false
	LoadingWindow.Visible = true

	local stages = {
		{0, "Purging old bypass engine..."},
		{35, "Injecting V26.5 FPS Optimizer & Telemetry HUD..."},
		{75, "Calibrating combat responsiveness..."},
		{100, "System active."}
	}

	for _, stage in ipairs(stages) do
		LoadingStatus.Text = stage[2]
		LoadingPercent.Text = tostring(stage[1]) .. "%"
		Tween(LoadingFill, {Size = UDim2.fromScale(stage[1] / 100, 1)}, 0.18):Play()
		task.wait(0.25)
	end

	LoadingWindow.Visible = false
	State.Loading = false
	State.Authenticated = true
	Main.Visible = true
	Reopen.Visible = false
	SelectPage(HomePage, HomeButton)
end

