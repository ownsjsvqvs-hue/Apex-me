local function NormalizeKey(text)
	return string.gsub(string.lower(tostring(text or "")), "%s+", "")
end

local function SubmitKey()
	if State.Destroyed or State.Loading then return end
	local entered = NormalizeKey(KeyBox.Text)

	if VALID_KEYS[entered] then
		KeyStatus.Text = "Access granted."
		KeyStatus.TextColor3 = Theme.Success
		EnterButton.Text = "LOADING..."
		task.wait(0.25)
		RunLoading()
	else
		KeyStatus.Text = "Invalid key."
		KeyStatus.TextColor3 = Theme.Danger
		KeyBox.Text = ""
	end
end

EnterButton.Activated:Connect(SubmitKey)
KeyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then SubmitKey() end
end)

