local function AddToggle(parent, title, description, callback)
	local card = MakeCard(parent, 74)

	local titleLabel = MakeText(card, title, 13, Theme.Text)
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Position = UDim2.fromScale(0.04, 0.10)
	titleLabel.Size = UDim2.fromScale(0.55, 0.25)

	local descriptionLabel = MakeText(card, description, 10, Theme.Muted)
	descriptionLabel.Position = UDim2.fromScale(0.04, 0.40)
	descriptionLabel.Size = UDim2.fromScale(0.55, 0.45)
	descriptionLabel.TextWrapped = true

	local status = MakeText(card, "OFF", 10, Theme.Muted)
	status.Font = Enum.Font.GothamBold
	status.Position = UDim2.fromScale(0.60, 0.32)
	status.Size = UDim2.fromScale(0.16, 0.30)
	status.TextXAlignment = Enum.TextXAlignment.Right

	local toggle = MakeButton(card, "")
	toggle.Position = UDim2.fromScale(0.80, 0.25)
	toggle.Size = UDim2.fromScale(0.15, 0.48)

	local knob = Instance.new("Frame")
	knob.BackgroundColor3 = Theme.Text
	knob.BorderSizePixel = 0
	knob.Size = UDim2.fromScale(0.38, 0.64)
	knob.Position = UDim2.fromScale(0.06, 0.18)
	knob.Parent = toggle
	Corner(knob, 20)

	local enabled = false

	local function Render()
		if enabled then
			Tween(toggle, {BackgroundColor3 = Theme.Success}, 0.1):Play()
			Tween(knob, {Position = UDim2.fromScale(0.56, 0.18)}, 0.1):Play()
			status.Text = "ON"
			status.TextColor3 = Theme.Success
		else
			Tween(toggle, {BackgroundColor3 = Theme.Card2}, 0.1):Play()
			Tween(knob, {Position = UDim2.fromScale(0.06, 0.18)}, 0.1):Play()
			status.Text = "OFF"
			status.TextColor3 = Theme.Muted
		end
	end

	toggle.Activated:Connect(function()
		enabled = not enabled
		Render()
		callback(enabled)
	end)

	Render()
	return function(value)
		enabled = value
		Render()
		callback(enabled)
	end
end

