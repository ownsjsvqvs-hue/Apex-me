local Tracer = Instance.new("Frame")
Tracer.AnchorPoint = Vector2.new(0.5, 0.5)
Tracer.BackgroundColor3 = Color3.fromRGB(255, 45, 65)
Tracer.BorderSizePixel = 0
Tracer.Visible = false
Tracer.Parent = Gui

local function UpdateTracer(targetPos3D)
	if not State.TracersEnabled or not targetPos3D then
		Tracer.Visible = false
		return
	end
	local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos3D)
	if not onScreen then
		Tracer.Visible = false
		return
	end
	local viewportSize = Camera.ViewportSize
	local startPos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
	local endPos = Vector2.new(screenPos.X, screenPos.Y)
	local distance = (endPos - startPos).Magnitude
	local center = (startPos + endPos) / 2
	local angle = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))

	Tracer.Size = UDim2.fromOffset(distance, 2)
	Tracer.Position = UDim2.fromOffset(center.X, center.Y)
	Tracer.Rotation = angle
	Tracer.Visible = true
end

local function GetEnemyUnderCrosshair()
	local localChar = Player.Character
	local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
	if not localRoot then return nil end

	local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	local closestHead = nil
	local closestScreenDist = Config.TargetThresholdFOV

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= Player and other.Character then
			local hum = other.Character:FindFirstChildOfClass("Humanoid")
			local head = other.Character:FindFirstChild("Head")

			if hum and hum.Health > 0 and head then
				local worldDist = (localRoot.Position - head.Position).Magnitude
				if worldDist <= Config.MaxDistance then
					local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
					if onScreen then
						local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
						if screenDist < closestScreenDist then
							closestHead = head
							closestScreenDist = screenDist
						end
					end
				end
			end
		end
	end
	return closestHead
end

local function ApplyHighlight(char)
	if State.HighlightObj and State.HighlightObj.Parent ~= char then
		State.HighlightObj:Destroy()
		State.HighlightObj = nil
	end
	if char and State.TargetHighlight and not State.HighlightObj then
		local hl = Instance.new("Highlight")
		hl.Adornee = char
		hl.FillColor = Color3.fromRGB(150, 40, 240)
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.FillTransparency = 0.5
		hl.Parent = char
		State.HighlightObj = hl
	end
end

local lastCheck = tick()
local frames = 0

RunService.RenderStepped:Connect(function()
	frames = frames + 1
	if tick() - lastCheck >= 1 then
		local ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
		local mem = math.floor(StatsService:GetTotalMemoryUsageMb())
		StatsLabel.Text = "FPS: " .. frames .. " | PING: " .. ping .. "ms | MEMORY: " .. mem .. " MB"
		frames = 0
		lastCheck = tick()
	end

	FOVRing.Visible = State.FOVRingEnabled

	if not State.AimbotEnabled then
		Tracer.Visible = false
		if State.HighlightObj then State.HighlightObj:Destroy() State.HighlightObj = nil end
		return
	end

	local targetHead = GetEnemyUnderCrosshair()

	if targetHead then
		local targetPos = targetHead.Position
		if State.PredictionEnabled and targetHead.AssemblyLinearVelocity then
			targetPos = targetPos + (targetHead.AssemblyLinearVelocity * Config.Prediction)
		end

		local currentCF = Camera.CFrame
		local targetCF = CFrame.lookAt(currentCF.Position, targetPos)
		Camera.CFrame = currentCF:Lerp(targetCF, Config.Smoothness)

		ApplyHighlight(targetHead.Parent)
		UpdateTracer(targetPos)
	else
		Tracer.Visible = false
		if State.HighlightObj then State.HighlightObj:Destroy() State.HighlightObj = nil end
	end
end)
